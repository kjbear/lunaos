              "mode": "raw",
              "raw": "{\n  \"name\": \"New Project\",\n  \"description\": \"A new project for testing\",\n  \"status\": \"planning\",\n  \"health\": \"healthy\",\n  \"architecture_type\": \"microservices\",\n  \"technologies\": [\"Laravel\", \"Vue\", \"Redis\"]\n}",
