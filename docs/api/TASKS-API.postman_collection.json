{
  "info": {
    "name": "LunaOS Task Management API",
    "description": "Unified Task Management API supporting multiple view modes (list, board, executive) with full CRUD operations, filtering, pagination, and sorting.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "Authorization",
        "type": "string"
      },
      {
        "key": "value",
        "value": "Bearer YOUR_API_TOKEN",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000/api",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Tasks",
      "description": "Task CRUD operations",
      "item": [
        {
          "name": "List All Tasks",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tasks?status=pending&priority=high,critical&sort=created_at&direction=desc&per_page=20&page=1",
              "host": ["{{baseUrl}}"],
              "path": ["tasks"],
              "query": [
                {
                  "key": "status",
                  "value": "pending",
                  "description": "Filter by status (comma-separated for multiple values)"
                },
                {
                  "key": "assigned_to",
                  "value": "dave",
                  "description": "Filter by agent name"
                },
                {
                  "key": "priority",
                  "value": "high,critical",
                  "description": "Filter by priority (comma-separated)"
                },
                {
                  "key": "task_type",
                  "value": "feature",
                  "description": "Filter by task type"
                },
                {
                  "key": "step",
                  "value": "develop",
                  "description": "Filter by workflow step"
                },
                {
                  "key": "view_mode",
                  "value": "board",
                  "description": "Filter by view mode"
                },
                {
                  "key": "repository_id",
                  "value": "5",
                  "description": "Filter by repository ID"
                },
                {
                  "key": "created_after",
                  "value": "2026-03-01",
                  "description": "Filter tasks created after this date (ISO 8601)"
                },
                {
                  "key": "created_before",
                  "value": "2026-03-31",
                  "description": "Filter tasks created before this date (ISO 8601)"
                },
                {
                  "key": "search",
                  "value": "authentication",
                  "description": "Search in title and description"
                },
                {
                  "key": "sort",
                  "value": "created_at",
                  "description": "Field to sort by"
                },
                {
                  "key": "direction",
                  "value": "desc",
                  "description": "Sort direction"
                },
                {
                  "key": "per_page",
                  "value": "20",
                  "description": "Items per page (max: 100)"
                },
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number"
                }
              ]
            }
          },
          "response": [
            {
              "name": "Success Response",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"data\": [\n    {\n      \"id\": 1,\n      \"title\": \"Implement user authentication\",\n      \"description\": \"Add login/logout functionality\",\n      \"assigned_to\": \"dave\",\n      \"repository_id\": 5,\n      \"status\": \"in_progress\",\n      \"step\": \"develop\",\n      \"priority\": \"high\",\n      \"task_type\": \"feature\",\n      \"view_mode\": \"board\",\n      \"context\": {},\n      \"branch_name\": \"feature/auth\",\n      \"pr_url\": \"https://github.com/example/repo/pull/42\",\n      \"artifacts\": [],\n      \"failure_reason\": null,\n      \"retry_count\": 0,\n      \"started_at\": \"2026-03-01T10:00:00Z\",\n      \"completed_at\": null,\n      \"created_at\": \"2026-03-01T09:00:00Z\",\n      \"updated_at\": \"2026-03-01T10:00:00Z\",\n      \"progress_percentage\": 20,\n      \"priority_badge_class\": \"bg-orange-500/20 text-orange-400 border-orange-500/30\",\n      \"status_badge_class\": \"bg-blue-500/20 text-blue-400 border-blue-500/30\",\n      \"agent_display_name\": \"Dave (Dev)\",\n      \"created_at_human\": \"2 hours ago\",\n      \"agent\": {\n        \"id\": 1,\n        \"name\": \"dave\",\n        \"role\": \"developer\",\n        \"avatar\": \"/avatars/dave.png\",\n        \"status\": \"online\"\n      },\n      \"repository\": {\n        \"id\": 5,\n        \"name\": \"example/repo\",\n        \"url\": \"https://github.com/example/repo\",\n        \"provider\": \"github\"\n      },\n      \"activities\": []\n    }\n  ],\n  \"links\": {\n    \"first\": \"/api/tasks?page=1\",\n    \"last\": \"/api/tasks?page=5\",\n    \"prev\": null,\n    \"next\": \"/api/tasks?page=2\"\n  },\n  \"meta\": {\n    \"current_page\": 1,\n    \"from\": 1,\n    \"last_page\": 5,\n    \"path\": \"/api/tasks\",\n    \"per_page\": 20,\n    \"to\": 20,\n    \"total\": 100\n  }\n}"
            }
          ]
        },
        {
          "name": "Create a Task",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Implement user authentication\",\n  \"description\": \"Add login/logout functionality with OAuth support\",\n  \"assigned_to\": \"dave\",\n  \"repository_id\": 5,\n  \"status\": \"pending\",\n  \"step\": \"develop\",\n  \"priority\": \"high\",\n  \"task_type\": \"feature\",\n  \"view_mode\": \"board\",\n  \"context_json\": {\n    \"requirements\": [\"OAuth2\", \"JWT tokens\", \"Session management\"]\n  },\n  \"branch_name\": \"feature/auth\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["tasks"]
            }
          },
          "response": [
            {
              "name": "Success Response",
              "status": "Created",
              "code": 201,
              "body": "{\n  \"data\": {\n    \"id\": 42,\n    \"title\": \"Implement user authentication\",\n    \"description\": \"Add login/logout functionality with OAuth support\",\n    \"assigned_to\": \"dave\",\n    \"repository_id\": 5,\n    \"status\": \"pending\",\n    \"step\": \"develop\",\n    \"priority\": \"high\",\n    \"task_type\": \"feature\",\n    \"view_mode\": \"board\",\n    \"context\": {\n      \"requirements\": [\"OAuth2\", \"JWT tokens\", \"Session management\"]\n    },\n    \"branch_name\": \"feature/auth\",\n    \"pr_url\": null,\n    \"artifacts\": [],\n    \"failure_reason\": null,\n    \"retry_count\": 0,\n    \"started_at\": null,\n    \"completed_at\": null,\n    \"created_at\": \"2026-03-01T12:00:00Z\",\n    \"updated_at\": \"2026-03-01T12:00:00Z\",\n    \"progress_percentage\": 20,\n    \"priority_badge_class\": \"bg-orange-500/20 text-orange-400 border-orange-500/30\",\n    \"status_badge_class\": \"bg-slate-500/20 text-slate-400 border-slate-500/30\",\n    \"agent_display_name\": \"Dave (Dev)\",\n    \"created_at_human\": \"just now\"\n  }\n}"
            }
          ]
        },
        {
          "name": "Get a Task",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tasks/{{taskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["tasks", "{{taskId}}"],
              "variable": [
                {
                  "key": "taskId",
                  "value": "1"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Update a Task",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated task title\",\n  \"description\": \"Updated description\",\n  \"status\": \"in_progress\",\n  \"priority\": \"critical\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tasks/{{taskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["tasks", "{{taskId}}"],
              "variable": [
                {
                  "key": "taskId",
                  "value": "1"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Delete a Task",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tasks/{{taskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["tasks", "{{taskId}}"],
              "variable": [
                {
                  "key": "taskId",
                  "value": "1"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Bulk Update Tasks",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"task_ids\": [1, 2, 3],\n  \"updates\": {\n    \"status\": \"in_progress\",\n    \"assigned_to\": \"dave\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tasks/bulk",
              "host": ["{{baseUrl}}"],
              "path": ["tasks", "bulk"]
            }
          },
          "response": []
        },
        {
          "name": "Bulk Delete Tasks",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"task_ids\": [1, 2, 3]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tasks/bulk",
              "host": ["{{baseUrl}}"],
              "path": ["tasks", "bulk"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Task Views",
      "description": "View-specific task endpoints",
      "item": [
        {
          "name": "Get Tasks by View Mode",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tasks/view-modes/{{viewMode}}?status=pending&sort=created_at&direction=desc",
              "host": ["{{baseUrl}}"],
              "path": ["tasks", "view-modes", "{{viewMode}}"],
              "query": [
                {
                  "key": "status",
                  "value": "pending",
                  "description": "Filter by status (comma-separated)"
                },
                {
                  "key": "assigned_to",
                  "value": "dave",
                  "description": "Filter by agent name"
                },
                {
                  "key": "priority",
                  "value": "high",
                  "description": "Filter by priority"
                },
                {
                  "key": "sort",
                  "value": "created_at",
                  "description": "Field to sort by"
                },
                {
                  "key": "direction",
                  "value": "desc",
                  "description": "Sort direction"
                },
                {
                  "key": "per_page",
                  "value": "20",
                  "description": "Items per page"
                },
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number"
                }
              ],
              "variable": [
                {
                  "key": "viewMode",
                  "value": "board"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Task Statistics",
      "description": "Task metrics and filter options",
      "item": [
        {
          "name": "Get Task Statistics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tasks/stats",
              "host": ["{{baseUrl}}"],
              "path": ["tasks", "stats"]
            }
          },
          "response": [
            {
              "name": "Success Response",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"total\": 150,\n  \"by_status\": {\n    \"pending\": 25,\n    \"in_progress\": 45,\n    \"complete\": 70,\n    \"failed\": 5,\n    \"blocked\": 5\n  },\n  \"by_priority\": {\n    \"low\": 30,\n    \"medium\": 80,\n    \"high\": 30,\n    \"critical\": 10\n  },\n  \"by_view_mode\": {\n    \"list\": 50,\n    \"board\": 75,\n    \"executive\": 25\n  },\n  \"by_step\": {\n    \"develop\": 30,\n    \"qa\": 25,\n    \"security\": 20,\n    \"staging\": 15,\n    \"production\": 60\n  },\n  \"completed_today\": 12,\n  \"active_agents\": 5\n}"
