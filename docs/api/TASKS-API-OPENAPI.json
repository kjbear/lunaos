{
  "openapi": "3.0.3",
  "info": {
    "title": "LunaOS Task Management API",
    "description": "Unified Task Management API supporting multiple view modes (list, board, executive) with full CRUD operations, filtering, pagination, and sorting.",
    "version": "1.0.0",
    "contact": {
      "name": "LunaOS API Team"
    }
  },
  "servers": [
    {
      "url": "/api",
      "description": "LunaOS API v1"
    }
  ],
  "tags": [
    {
      "name": "Tasks",
      "description": "Task CRUD operations"
    },
    {
      "name": "Task Views",
      "description": "View-specific task endpoints"
    },
    {
      "name": "Task Statistics",
      "description": "Task metrics and filter options"
    }
  ],
  "paths": {
    "/tasks": {
      "get": {
        "tags": ["Tasks"],
        "summary": "List all tasks",
        "description": "Retrieve a paginated list of tasks with optional filtering, sorting, and search.",
        "operationId": "listTasks",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "description": "Filter by status (comma-separated for multiple values)",
            "schema": {
              "type": "string",
              "example": "pending,in_progress"
            }
          },
          {
            "name": "assigned_to",
            "in": "query",
            "description": "Filter by agent name",
            "schema": {
              "type": "string",
              "example": "dave"
            }
          },
          {
            "name": "priority",
            "in": "query",
            "description": "Filter by priority (comma-separated)",
            "schema": {
              "type": "string",
              "example": "high,critical"
            }
          },
          {
            "name": "task_type",
            "in": "query",
            "description": "Filter by task type",
            "schema": {
              "type": "string",
              "example": "feature"
            }
          },
          {
            "name": "step",
            "in": "query",
            "description": "Filter by workflow step",
            "schema": {
              "type": "string",
              "example": "develop"
            }
          },
          {
            "name": "view_mode",
            "in": "query",
            "description": "Filter by view mode",
            "schema": {
              "type": "string",
              "enum": ["list", "board", "executive"]
            }
          },
          {
            "name": "repository_id",
            "in": "query",
            "description": "Filter by repository ID",
            "schema": {
              "type": "integer",
              "example": 5
            }
          },
          {
            "name": "created_after",
            "in": "query",
            "description": "Filter tasks created after this date (ISO 8601)",
            "schema": {
              "type": "string",
              "format": "date",
              "example": "2026-03-01"
            }
          },
          {
            "name": "created_before",
            "in": "query",
            "description": "Filter tasks created before this date (ISO 8601)",
            "schema": {
              "type": "string",
              "format": "date",
              "example": "2026-03-31"
            }
          },
          {
            "name": "search",
            "in": "query",
            "description": "Search in title and description",
            "schema": {
              "type": "string",
              "example": "authentication"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "Field to sort by",
            "schema": {
              "type": "string",
              "default": "created_at",
              "enum": ["id", "title", "created_at", "updated_at", "started_at", "completed_at", "status", "priority", "step", "task_type"]
            }
          },
          {
            "name": "direction",
            "in": "query",
            "description": "Sort direction",
            "schema": {
              "type": "string",
              "default": "desc",
              "enum": ["asc", "desc"]
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "description": "Items per page (max: 100)",
            "schema": {
              "type": "integer",
              "default": 20,
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Page number",
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/TaskResource"
                      }
                    },
                    "links": {
                      "$ref": "#/components/schemas/PaginationLinks"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/PaginationMeta"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request - Invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Tasks"],
        "summary": "Create a task",
        "description": "Create a new task with the provided details.",
        "operationId": "createTask",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTaskRequest"
              },
              "examples": {
                "example-1": {
                  "summary": "Create a feature task",
                  "value": {
                    "title": "Implement user authentication",
                    "description": "Add login/logout functionality with OAuth support",
                    "assigned_to": "dave",
                    "repository_id": 5,
                    "status": "pending",
                    "step": "develop",
                    "priority": "high",
                    "task_type": "feature",
                    "view_mode": "board",
                    "context_json": {
                      "requirements": ["OAuth2", "JWT tokens", "Session management"]
                    },
                    "branch_name": "feature/auth"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Task created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/TaskResource"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/tasks/view-modes/{viewMode}": {
      "get": {
        "tags": ["Task Views"],
        "summary": "Get tasks by view mode",
        "description": "Retrieve tasks filtered by a specific view mode.",
        "operationId": "getTasksByViewMode",
        "parameters": [
          {
            "name": "viewMode",
            "in": "path",
            "required": true,
            "description": "View mode identifier",
            "schema": {
              "type": "string",
              "enum": ["list", "board", "executive"]
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Filter by status (comma-separated)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "assigned_to",
            "in": "query",
            "description": "Filter by agent name",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "priority",
            "in": "query",
            "description": "Filter by priority (comma-separated)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "created_at"
            }
          },
          {
            "name": "direction",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "desc"
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/TaskResource"
                      }
                    },
                    "links": {
                      "$ref": "#/components/schemas/PaginationLinks"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/PaginationMeta"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid view mode",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Invalid view mode"
                    },
                    "allowed": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "example": ["list", "board", "executive"]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/tasks/stats": {
      "get": {
        "tags": ["Task Statistics"],
        "summary": "Get task statistics",
        "description": "Retrieve aggregated statistics about tasks.",
        "operationId": "getTaskStats",
        "responses": {
          "200": {
            "description": "Task statistics",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskStats"
                }
              }
            }
          }
        }
      }
    },
    "/tasks/filters": {
      "get": {
        "tags": ["Task Statistics"],
        "summary": "Get filter options",
        "description": "Retrieve available filter options for tasks.",
        "operationId": "getTaskFilters",
        "responses": {
          "200": {
            "description": "Filter options",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskFilters"
                }
              }
            }
          }
        }
      }
    },
    "/tasks/{task}": {
      "get": {
        "tags": ["Tasks"],
        "summary": "Get a task",
        "description": "Retrieve a single task by ID.",
        "operationId": "getTask",
        "parameters": [
          {
            "name": "task",
            "in": "path",
            "required": true,
            "description": "Task ID",
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/TaskResource"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Task not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["Tasks"],
        "summary": "Update a task",
        "description": "Update an existing task. All fields are optional for update.",
        "operationId": "updateTask",
        "parameters": [
          {
            "name": "task",
            "in": "path",
            "required": true,
            "description": "Task ID",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateTaskRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/TaskResource"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Task not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["Tasks"],
        "summary": "Delete a task",
        "description": "Delete a task permanently.",
        "operationId": "deleteTask",
        "parameters": [
          {
            "name": "task",
            "in": "path",
            "required": true,
            "description": "Task ID",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Task deleted successfully"
          },
          "404": {
            "description": "Task not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/tasks/bulk": {
      "put": {
        "tags": ["Tasks"],
        "summary": "Bulk update tasks",
        "description": "Update multiple tasks with the same changes.",
        "operationId": "bulkUpdateTasks",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkUpdateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tasks updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Tasks updated successfully"
                    },
                    "updated_count": {
                      "type": "integer",
                      "example": 3
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["Tasks"],
        "summary": "Bulk delete tasks",
        "description": "Delete multiple tasks.",
        "operationId": "bulkDeleteTasks",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkDeleteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tasks deleted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Tasks deleted successfully"
                    },
                    "deleted_count": {
                      "type": "integer",
                      "example": 3
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "API token authentication (optional for internal use)"
      }
    },
    "schemas": {
      "TaskResource": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Task ID",
            "example": 1
          },
          "title": {
            "type": "string",
            "description": "Task title",
            "example": "Implement user authentication"
          },
          "description": {
            "type": "string",
            "nullable": true,
            "description": "Task description",
            "example": "Add login/logout functionality"
          },
          "assigned_to": {
            "type": "string",
            "nullable": true,
            "description": "Agent name assigned to task",
            "example": "dave"
          },
          "repository_id": {
            "type": "integer",
            "nullable": true,
            "description": "Repository ID",
            "example": 5
          },
          "status": {
            "type": "string",
            "enum": ["pending", "in_progress", "complete", "failed", "blocked"],
            "description": "Current task status",
            "example": "in_progress"
          },
          "step": {
            "type": "string",
            "enum": ["develop", "qa", "security", "staging", "production"],
            "description": "Workflow step",
            "example": "develop"
          },
          "priority": {
            "type": "string",
            "enum": ["low", "medium", "high", "critical"],
            "description": "Task priority",
            "example": "high"
          },
          "task_type": {
            "type": "string",
            "enum": ["feature", "bug", "chore", "hotfix", "refactor"],
            "description": "Type of task",
            "example": "feature"
          },
          "view_mode": {
            "type": "string",
            "enum": ["list", "board", "executive"],
            "description": "View mode association",
            "example": "board"
          },
          "context": {
            "type": "object",
            "nullable": true,
            "description": "Additional context data",
            "additionalProperties": true
          },
          "branch_name": {
            "type": "string",
            "nullable": true,
            "description": "Git branch name",
            "example": "feature/auth"
          },
          "pr_url": {
            "type": "string",
            "nullable": true,
            "format": "uri",
            "description": "Pull request URL",
            "example": "https://github.com/example/repo/pull/42"
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Generated artifacts",
            "example": []
          },
          "failure_reason": {
            "type": "string",
            "nullable": true,
            "description": "Reason for failure (if failed)"
          },
          "retry_count": {
            "type": "integer",
            "description": "Number of retry attempts",
            "example": 0
          },
          "started_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "When work started"
          },
          "completed_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "When task was completed"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Creation timestamp"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Last update timestamp"
          },
          "progress_percentage": {
            "type": "integer",
            "description": "Progress percentage (0-100)",
            "example": 20
          },
          "priority_badge_class": {
            "type": "string",
            "description": "CSS class for priority badge",
            "example": "bg-orange-500/20 text-orange-400 border-orange-500/30"
          },
          "status_badge_class": {
            "type": "string",
            "description": "CSS class for status badge",
            "example": "bg-blue-500/20 text-blue-400 border-blue-500/30"
          },
          "agent_display_name": {
            "type": "string",
            "description": "Display name of assigned agent",
            "example": "Dave (Dev)"
          },
          "created_at_human": {
            "type": "string",
            "description": "Human-readable creation time",
            "example": "2 hours ago"
          },
          "agent": {
            "$ref": "#/components/schemas/AgentResource"
          },
          "repository": {
            "$ref": "#/components/schemas/RepositoryResource"
          },
          "activities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AgentActivityResource"
            }
          }
        }
      },
      "AgentResource": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "dave"
          },
          "role": {
            "type": "string",
            "example": "developer"
          },
          "avatar": {
            "type": "string",
            "example": "/avatars/dave.png"
          },
          "status": {
            "type": "string",
            "example": "online"
          }
        }
      },
      "RepositoryResource": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 5
          },
          "name": {
            "type": "string",
            "example": "example/repo"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "example": "https://github.com/example/repo"
          },
          "provider": {
            "type": "string",
            "example": "github"
          }
        }
      },
      "AgentActivityResource": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "agent_name": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateTaskRequest": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 255,
            "example": "Implement user authentication"
          },
          "description": {
            "type": "string",
            "example": "Add login/logout functionality with OAuth support"
          },
          "assigned_to": {
            "type": "string",
            "description": "Must exist in agents table (name)"
          },
          "repository_id": {
            "type": "integer",
            "description": "Must exist in repositories table"
          },
          "status": {
            "type": "string",
            "enum": ["pending", "in_progress", "complete", "failed", "blocked"],
            "default": "pending"
          },
          "step": {
            "type": "string",
            "enum": ["develop", "qa", "security", "staging", "production"],
            "default": "develop"
          },
          "priority": {
            "type": "string",
            "enum": ["low", "medium", "high", "critical"],
            "default": "medium"
          },
          "task_type": {
            "type": "string",
            "enum": ["feature", "bug", "chore", "hotfix", "refactor"],
            "default": "feature"
          },
          "view_mode": {
            "type": "string",
            "enum": ["list", "board", "executive"],
            "default": "list"
          },
          "context_json": {
            "type": "object",
            "additionalProperties": true,
            "description": "Context data as JSON object"
          },
          "branch_name": {
            "type": "string",
            "maxLength": 255
          },
          "pr_url": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048
          }
        }
      },
      "UpdateTaskRequest": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 255
          },
          "description": {
            "type": "string"
          },
          "assigned_to": {
            "type": "string"
          },
          "repository_id": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "enum": ["pending", "in_progress", "complete", "failed", "blocked"]
          },
          "step": {
            "type": "string",
            "enum": ["develop", "qa", "security", "staging", "production"]
          },
          "priority": {
